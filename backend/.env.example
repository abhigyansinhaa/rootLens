# Copy to `backend/.env` for local runs (or use Docker Compose with repo-root `.env` from `env.example`).
# Never commit real secrets.

# ── Required: JWT signing secret ─────────────────────────────────────────────
# Min 32 characters, not a placeholder (see app.config FORBIDDEN_SECRET_KEYS).
SECRET_KEY=

# ── Required: Database connection ────────────────────────────────────────────
# For direct local runs — match user/password to your MySQL instance.
# With Docker Compose these are built automatically from the vars below.
DATABASE_URL=mysql+pymysql://rootLens_user:CHANGE_ME@127.0.0.1:3306/rootLens_db

# ── Required when using Docker Compose ───────────────────────────────────────
# No fallback defaults — Compose will refuse to start without these being set.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── Optional: Redis for RQ worker-backed analyses ─────────────────────────────
# Omit for BackgroundTasks mode (not suitable for production).
# REDIS_URL=redis://redis:6379/0
